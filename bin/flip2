#!/usr/bin/env bash
# Flip2 toolkit CLI — modular pipelines for menu overlay and recovery.
set -euo pipefail
FLIP2_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=/dev/null
source "$FLIP2_ROOT/lib/bootstrap.sh"

usage() {
  cat <<EOF
Usage: flip2 <command> [args]

Commands:
  apply              Sync slots.json → build overlay → install → enable (USB + root)
  slot <1-9> <pkg>   Set one menu slot and run apply
  swap <a> <b>       Swap two menu slots (1–9) and apply
  editor             Start web editor (http://127.0.0.1:${FLIP2_EDITOR_PORT})
  recovery           Remove bad launcher Magisk module, restore stock Launcher3, apply overlay
  pack-overlay       Build Magisk zip for overlay only (launcher-overlay/dist/)
  home-keys          Apply home-keys.json to Settings.Global
  display <sub>      Global density / font / screen-compat (see docs/DISPLAY-DPI.md)
  fork <subcmd>      Launcher3 fork (Magisk): build | pack | install | rollback | status | extract
  launcher4 <sub>    User APK com.tim.flip2.launcher4: build | install | set-home | uninstall | status
  ime <sub>          Null keyboard + STT: build | hide-bar | restore | status | models | lang
  keypad <sub>       matrix-keypad KL: physical ⌫ → DEL (status | rollback)
  navoverlay <sub>   framework-res RRO (menu bar/navbar 0px): build | install | status | rollback
  tagdrawer <sub>    Pixel Tag Drawer system (Magisk): pack | install | rollback | status
  vmouse <sub>       Simple mouse (neutronscott simple-release1): install | status
  flipmouse <sub>    FlipMouse virtual mouse (vendored, Magisk): build | install | status | rollback
  forkgram <sub>     Patched Forkgram APK: patch | release (BACK deletes in text fields)
  setup <tier>       Deployment: full (rooted set in verified order) | clean
  installer <sub>    Single-shot Magisk installer: pack [--flavor clean|full]
  pack-all           Build per-component Magisk zips + APKs + SHA256SUMS bundle
  deroot             Remove flip2 root components; keep user APKs + settings
  image <sub>        Base-image system tree: build-tree

Environment:
  FLIP2_ROOT         Repo root (default: $FLIP2_ROOT)
  FLIP2_EDITOR_PORT  Editor port (default: $FLIP2_EDITOR_PORT)

Docs: $FLIP2_ROOT/docs/PIPELINE.md
EOF
}

cmd="${1:-}"
shift || true

case "$cmd" in
  apply)
    exec "$FLIP2_PIPELINE/overlay/apply.sh"
    ;;
  slot)
    [[ $# -ge 2 ]] || { echo "Usage: flip2 slot <1-9> <package-or-@tools>" >&2; exit 1; }
    exec "$FLIP2_OVERLAY/scripts/edit-slot.sh" "$@"
    ;;
  swap)
    [[ $# -ge 2 ]] || { echo "Usage: flip2 swap <1-9> <1-9>" >&2; exit 1; }
    exec "$FLIP2_PIPELINE/overlay/swap-slots.sh" "$@"
    ;;
  editor)
    flip2_env_init
    if adb get-state >/dev/null 2>&1; then
      adb reverse "tcp:${FLIP2_EDITOR_PORT}" "tcp:${FLIP2_EDITOR_PORT}" 2>/dev/null \
        && echo "Phone: http://127.0.0.1:${FLIP2_EDITOR_PORT}"
    fi
    exec python3 "$FLIP2_OVERLAY/scripts/serve-editor.py"
    ;;
  recovery)
    exec "$FLIP2_PIPELINE/recovery/resolve.sh"
    ;;
  pack-overlay)
    exec "$FLIP2_OVERLAY/scripts/pack-magisk-module.sh"
    ;;
  home-keys)
    exec "$FLIP2_OVERLAY/scripts/apply-home-keys.sh"
    ;;
  display)
    exec "$FLIP2_PIPELINE/display/display.sh" "$@"
    ;;
  fork)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      extract) exec "$FLIP2_FORK/scripts/extract-from-stock.sh" ;;
      build)   exec "$FLIP2_FORK/scripts/build.sh" ;;
      pack)    exec "$FLIP2_FORK/scripts/pack.sh" ;;
      install) exec "$FLIP2_FORK/scripts/install.sh" ;;
      rollback) exec "$FLIP2_FORK/scripts/rollback.sh" ;;
      status)  exec "$FLIP2_FORK/scripts/status.sh" ;;
      help|-h|--help)
        echo "Usage: flip2 fork {extract|build|pack|install|rollback|status}"
        ;;
      *) echo "Unknown fork subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  launcher4)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      build)     exec "$FLIP2_LAUNCHER4/scripts/build.sh" ;;
      install)   exec "$FLIP2_LAUNCHER4/scripts/install.sh" ;;
      set-home)  exec "$FLIP2_LAUNCHER4/scripts/set-home.sh" ;;
      uninstall) exec "$FLIP2_LAUNCHER4/scripts/uninstall.sh" ;;
      status)
        PKG="${FLIP2_LAUNCHER4_PKG:-com.tim.flip2.launcher4}"
        APK="$FLIP2_LAUNCHER4/dist/launcher4.apk"
        [[ -f "$APK" ]] && echo "Built: $APK ($(wc -c <"$APK" | tr -d ' ') bytes)" || echo "Not built — run: flip2 launcher4 build"
        if adb get-state >/dev/null 2>&1; then
          adb shell pm path "$PKG" 2>/dev/null || echo "Not installed on device"
        fi
        ;;
      help|-h|--help)
        echo "Usage: flip2 launcher4 {build|install|set-home|uninstall|status}"
        echo "  Safe path: user APK + pick Home — does NOT replace /system Launcher3."
        ;;
      *) echo "Unknown launcher4 subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  tagdrawer)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      pack)      exec "$FLIP2_TAGDRAWER/scripts/pack.sh" ;;
      install)   exec "$FLIP2_TAGDRAWER/scripts/install.sh" ;;
      rollback)  exec "$FLIP2_TAGDRAWER/scripts/rollback.sh" ;;
      status)    exec "$FLIP2_TAGDRAWER/scripts/status.sh" ;;
      help|-h|--help)
        echo "Usage: flip2 tagdrawer {pack|install|rollback|status}"
        echo "  /system/app/PixelTagDrawer via Magisk. D-pad Up: home-keys.json + flip2 home-keys."
        ;;
      *) echo "Unknown tagdrawer subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  vmouse)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      install) exec "$FLIP2_ROOT/vmouse/scripts/install-simple.sh" ;;
      status)
        if adb get-state >/dev/null 2>&1; then
          adb shell "su -c 'wc -c /data/adb/modules/vMouse/mouse 2>/dev/null; ls /data/adb/service.d/flip2-vmouse* 2>/dev/null; pgrep -a mouse 2>/dev/null'" 2>/dev/null || true
        fi
        BIN="$FLIP2_ROOT/vmouse/stock/mouse"
        [[ -f "$BIN" ]] && echo "Local simple mouse: $BIN ($(wc -c <"$BIN" | tr -d ' ') bytes)" || echo "Run: flip2 vmouse install (fetches binary)"
        ;;
      help|-h|--help)
        echo "Usage: flip2 vmouse {install|status}"
        echo "  simple-release1 binary into Magisk vMouse module. Long-press left soft key to toggle."
        echo "  https://github.com/neutronscott/flip2/releases/tag/simple-release1"
        ;;
      *) echo "Unknown vmouse subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  flipmouse)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      build)    exec "$FLIP2_ROOT/pipeline/flipmouse/build.sh" "$@" ;;
      install)  exec "$FLIP2_ROOT/pipeline/flipmouse/install.sh" ;;
      status)   exec "$FLIP2_ROOT/pipeline/flipmouse/status.sh" ;;
      rollback) exec "$FLIP2_ROOT/pipeline/flipmouse/rollback.sh" ;;
      help|-h|--help)
        echo "Usage: flip2 flipmouse {build|install|status|rollback}"
        echo "  Vendored TylerBoni/FlipMouse, flip2-patched: soft-left 2s hold toggles"
        echo "  Hold upper-left soft key 2s + release to toggle. Star also exits. See pipeline/flipmouse/VENDORED.md."
        ;;
      *) echo "Unknown flipmouse subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  forkgram)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      patch) exec "$FLIP2_ROOT/pipeline/forkgram/patch-forkgram.sh" "$@" ;;
      release) exec "$FLIP2_ROOT/pipeline/forkgram/install-release.sh" "$@" ;;
      help|-h|--help)
        echo "Usage: flip2 forkgram {patch|release}"
        echo "  patch [--apk PATH] [--no-install] [--uninstall]"
        echo "      Build the patched APK from a local/device base APK."
        echo "  release [--no-install] [--uninstall]"
        echo "      Download, verify, and install the hosted patch build."
        echo "  Telegram owns hardware BACK, so the IME cannot delete there; the patch"
        echo "  makes BACK delete in focused text fields. See pipeline/forkgram/README.md."
        ;;
      *) echo "Unknown forkgram subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  navoverlay)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      build)  exec "$FLIP2_ROOT/framework-nav-overlay/scripts/build-and-install.sh" build ;;
      install)
        "$FLIP2_ROOT/framework-nav-overlay/scripts/pack.sh"
        adb push "$FLIP2_ROOT/framework-nav-overlay/dist/flip2_nav_overlay-magisk.zip" /sdcard/Download/ >/dev/null
        adb shell "su -c 'magisk --install-module /sdcard/Download/flip2_nav_overlay-magisk.zip'" >/dev/null 2>&1 || true
        adb shell su -c "unzip -o /sdcard/Download/flip2_nav_overlay-magisk.zip -d /data/adb/modules/flip2_nav_overlay/ >/dev/null"
        echo "Reboot required, then: su cmd overlay enable com.tim.flip2.navoverlay (if not [x])."
        ;;
      status)
        adb get-state >/dev/null 2>&1 || { echo "No adb device"; exit 1; }
        adb shell "ls /product/overlay/Flip2NavOverlay.apk 2>/dev/null" | tr -d '\r'
        adb shell cmd overlay list 2>/dev/null | grep navoverlay
        adb shell "su -c 'ls /data/adb/modules/flip2_nav_overlay/module.prop 2>/dev/null'" | tr -d '\r'
        ;;
      rollback)
        adb shell su -c "rm -rf /data/adb/modules/flip2_nav_overlay" && echo "Removed module — reboot to restore stock menu bar."
        ;;
      help|-h|--help)
        echo "Usage: flip2 navoverlay {build|install|status|rollback}"
        echo " framework-res RRO: decor menu bar + navigation_bar_height = 0."
        echo "  Removes the phantom 30px black bar that clips chat input (Forkgram, Messages…)."
        ;;
      *) echo "Unknown navoverlay subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  keypad)
    sub="${1:-help}"
    shift || true
    KH="$FLIP2_ROOT/keypad-backspace"
    case "$sub" in
      status)
        adb get-state >/dev/null 2>&1 || { echo "No adb device"; exit 1; }
        echo -n "KL line: "; adb shell su -c "cat /system/usr/keylayout/matrix-keypad.kl" 2>/dev/null | grep 'key 138' | tr -d '\r'
        adb shell "dumpsys input 2>/dev/null" | grep -A12 'matrix-keypad ' | grep -o 'KeyLayoutFile.*' | sort -u | tr -d '\r'
        echo -n "Module: "; adb shell su -c "ls /data/adb/modules/flip2_keypad_backspace/module.prop 2>/dev/null" | tr -d '\r'
        ;;
      rollback)
        adb shell su -c "rm -rf /data/adb/modules/flip2_keypad_backspace" && echo "Removed module — reboot restores stock mapping (⌫ = FAVORITE_CONTACTS)."
        ;;
      help|-h|--help)
        echo "Usage: flip2 keypad {status|rollback}"
        echo "  matrix-keypad.kl: physical backspace (code 138/KEY_HELP) → DEL."
        echo "  Stock ROM mapped it to FAVORITE_CONTACTS (dead key)."
        ;;
      *) echo "Unknown keypad subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  ime)
    exec "$FLIP2_PIPELINE/ime/ime.sh" "$@"
    ;;
  setup)
    exec "$FLIP2_ROOT/pipeline/deploy/setup.sh" "$@"
    ;;
  installer)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      pack) exec "$FLIP2_ROOT/pipeline/deploy/pack-installer.sh" "$@" ;;
      help|-h|--help)
        echo "Usage: flip2 installer pack [--flavor clean|full] [--no-zip]"
        echo "  Single-shot Magisk installer zip. clean = user APKs + settings only,"
        echo "  self-removing, de-root friendly. full = full rooted set."
        ;;
      *) echo "Unknown installer subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  pack-all)
    exec "$FLIP2_ROOT/pipeline/deploy/pack-all.sh" "$@"
    ;;
  deroot)
    exec "$FLIP2_ROOT/pipeline/deploy/deroot.sh" "$@"
    ;;
  image)
    sub="${1:-help}"
    shift || true
    case "$sub" in
      build-tree) exec "$FLIP2_ROOT/pipeline/image/build-tree.sh" "$@" ;;
      help|-h|--help)
        echo "Usage: flip2 image build-tree"
        echo "  Assemble dist/flip2-system-tree/ (system apps + overlays) for base-image builds."
        echo "  See docs/IMAGE-BUILD.md."
        ;;
      *) echo "Unknown image subcommand: $sub" >&2; exit 1 ;;
    esac
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
