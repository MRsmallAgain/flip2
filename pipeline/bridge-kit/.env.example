# Copy to .env on the VPS/homelab host only — never commit .env

# Matrix homeserver (Synapse) — production default
SYNAPSE_SERVER_NAME=bridge.flip2burn.online
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me

# Appservice / bridge registration tokens (generate per upstream bridge docs)
MAUTRIX_WHATSAPP_AS_TOKEN=
MAUTRIX_WHATSAPP_HS_TOKEN=
MAUTRIX_SIGNAL_AS_TOKEN=
MAUTRIX_SIGNAL_HS_TOKEN=
MAUTRIX_GVOICE_AS_TOKEN=
MAUTRIX_GVOICE_HS_TOKEN=

# Synapse base URL bridges use (https://matrix.example.com)
HOMESERVER_URL=https://matrix.example.com
