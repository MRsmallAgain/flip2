# Copy to .env on the VPS/homelab host only — never commit .env
# Generate locally: flip2 bridges rotate-creds  (writes pipeline/bridge-kit/.env)

SYNAPSE_SERVER_NAME=bridge.flip2burn.online
HOMESERVER_URL=https://bridge.flip2burn.online
SYNAPSE_REGISTRATION_SHARED_SECRET=
POSTGRES_PASSWORD=

MATRIX_ADMIN_LOCALPART=flip2admin
MATRIX_ADMIN_MXID=@flip2admin:bridge.flip2burn.online
MATRIX_ADMIN_PASSWORD=
MAUTRIX_ADMIN_MXID=@flip2admin:bridge.flip2burn.online

SYNAPSE_HTTP_PORT=8008

# mautrix appservice tokens: generated in bridge volumes (register-bridges.sh), not in .env
