<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tim.flip2.nullkeyboard"
    android:versionCode="33"
    android:versionName="2.5.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- DTMF tone muting while typing (* / # on the matrix keypad). Special
         appop permission: no runtime dialog; grant with `cmd appops set ...`. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <application android:label="Flip2 Null Keyboard" android:allowBackup="false"
        android:extractNativeLibs="true">
        <service
            android:name=".NullKeyboardService"
            android:exported="true"
            android:theme="@style/Theme.Flip2NullIme"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
