{
  "name": "flip2-companion",
  "productName": "TCL Flip2 Manager",
  "version": "1.2.0",
  "description": "Desktop companion for the Flip 2 setup wizard: host adb install/verify, catalog downloads, Linux udev one-click.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:safe": "ELECTRON_DISABLE_GPU=1 electron . --disable-gpu --disable-gpu-compositing",
    "sync:icons": "node scripts/rasterize-wizard-icon.mjs",
    "fetch:platform-tools:win": "node scripts/fetch-platform-tools-win.mjs",
    "prepack:win": "npm run sync:icons && npm run fetch:platform-tools:win",
    "prepack:linux": "npm run sync:icons",
    "pack:win": "electron-builder --win --x64",
    "pack:linux": "electron-builder --linux",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "com.tim.flip2.companion",
    "productName": "TCL Flip2 Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "../wizard",
        "to": "wizard",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**"
        ]
      },
      {
        "from": "platform-tools-win",
        "to": "platform-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "icons/icon.png",
    "win": {
      "icon": "icons/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "flip2-companion-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility",
      "artifactName": "flip2-companion-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
